{
  "name": "@minilo/minitor",
  "version": "0.0.1",
  "description": "monitoring SDK",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "demo": "node test/server.js"
  },
  "keywords": [
    "error-monitor",
    "frontend",
    "sdk"
  ],
  "exports": {
    ".": {
      "development": {
        "types": "./core/index.ts",
        "import": "./core/index.ts",
        "require": "./core/index.ts"
      },
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs.js",
      "default": "./dist/core/index.esm.js"
    },
    "./plugin": {
      "development": {
        "types": "./plugin/index.ts",
        "import": "./plugin/index.ts",
        "require": "./plugin/index.ts"
      },
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.esm.js",
      "require": "./dist/plugin/index.cjs.js",
      "default": "./dist/plugin/index.esm.js"
    },
    "./screen": {
      "development": {
        "types": "./screen/index.ts",
        "import": "./screen/index.ts",
        "require": "./screen/index.ts"
      },
      "types": "./dist/screen/index.d.ts",
      "import": "./dist/screen/index.esm.js",
      "require": "./dist/screen/index.cjs.js",
      "default": "./dist/screen/index.esm.js"
    },
    "./vital": {
      "development": {
        "types": "./vital/index.ts",
        "import": "./vital/index.ts",
        "require": "./vital/index.ts"
      },
      "types": "./dist/vital/index.d.ts",
      "import": "./dist/vital/index.esm.js",
      "require": "./dist/vital/index.cjs.js",
      "default": "./dist/vital/index.esm.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "rollup": "^4.9.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^2.15.4",
    "web-vitals": "^5.1.0"
  }
}
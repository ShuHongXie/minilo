{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "declaration": true,
    "declarationDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "downlevelIteration": true,
    "lib": ["es2015", "dom"]
  },
  "include": [
    "core/**/*",
    "plugin/**/*",
    "screen/**/*",
    "vital/**/*",
    "index.ts",
    "../test.ts",
    "test.ts"
  ]
}
